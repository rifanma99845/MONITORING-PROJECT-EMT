# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# GOOGLE_SHEET_ID: The ID of the Google Spreadsheet containing the configuration.
VITE_GOOGLE_SHEET_ID=
# APPS_SCRIPT_URL: The Web App URL from Google Apps Script.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx1Sh54121UlLX9lNHPX43_AxYSXIOdiU7KoQrYH4Eyi3230drokGDEyf9l57n3YDTC/exec
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
